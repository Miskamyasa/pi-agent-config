{
  "lastChangelogVersion": "0.84.4",
  "defaultProvider": "neuralwatt",
  "defaultModel": "glm-5.2-short",
  "defaultThinkingLevel": "medium",
  "quietStartup": true,
  "theme": "e-ink",
  "tuiMode": "fullscreen",
  "enableInstallTelemetry": true,
  "packages": [
    "npm:@miskamyasa/pi-model-project-persist@1.0.0",
    "npm:pi-ollama-cloud",
    "npm:pi-mcp-adapter",
    "npm:pi-tool-display"
  ],
  "hideThinkingBlock": true,
  "enabledModels": [
    "anthropic/claude-opus-5",
    "cpa/deepseek/deepseek-flash",
    "cpa/hetzner/qwen3.6-35b-a3b",
    "cpa/hetzner/qwen3.8-27B",
    "cpa/jalapeno/glm-5.2",
    "cpa/jalapeno/glm-5.3",
    "cpa/jalapeno/glm-5.3-flash",
    "cpa/neuralwatt/glm-5.3",
    "cpa/neuralwatt/glm-5.3-flash",
    "cpa/neuralwatt/kimi-k3",
    "cpa/nube/glm-5.2",
    "cpa/nube/glm-5.3",
    "cpa/nube/glm-5.3-flash",
    "cpa/nube/kimi-k3",
    "ollama-cloud/gpt-oss:120b",
    "openai/gpt-5.6-sol"
  ],
  "enableSkillCommands": false,
  "showHardwareCursor": false,
  "steeringMode": "one-at-a-time",
  "followUpMode": "one-at-a-time",
  "collapseChangelog": true,
  "treeFilterMode": "no-tools",
  "compaction": {
    "enabled": false
  },
  "outputPad": 1,
  "showCacheMissNotices": true,
  "defaultProjectTrust": "ask",
  "terminal": {
    "showImages": true,
    "showTerminalProgress": false
  },
  "editorPaddingX": 1,
  "images": {
    "autoResize": true
  },
  "pi-memory-mnemosyne": {
    "url": "https://mnemosyne.paragraph.red/mcp",
    "token": "${MEMORY_MCP_TOKEN}",
    "memoryMode": "hybrid",
    "topK": 5,
    "bank": "default",
    "bankScope": "exact",
    "consolidateOnShutdown": true,
    "captureTurns": true,
    "distillModel": "openai/gpt-5.6-luna"
  },
  "aside": {
    "model": "cpa/nube/glm-5.3-flash"
  },
  "fullscreenCopyOnSelect": true,
  "fullscreenScrollbar": "auto",
  "fullscreenExitOutput": "resume-hint",
  "transport": "auto",
  "httpIdleTimeoutMs": 60000
}
